      "id": "34687b74-78ec-4a20-b91c-3de14fc0dc83",
      "name": "ArXiv request"
    },
    {
      "parameters": {
        "jsCode": "// Get all papers collected across all loop iterations\nconst allItems = $input.all();\n\n// Read existing papers already in the sheet to avoid duplicates\n// (We'll wire this up properly once the Google Sheets read node is added before this)\n\nconst seen = new Set();\nconst uniquePapers = [];\n\nfor (const item of allItems) {\n  const key = item.json.paper_id || item.json.title;\n  if (key && !seen.has(key)) {\n    seen.add(key);\n    uniquePapers.push({ json: { ...item.json, status: 'new', date_collected: new Date().toISOString() } });\n  }\n}\n\nreturn uniquePapers;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        592,
        -48
      ],
      "id": "3e55d2ab-39fe-4d82-81e5-5ee6b289c5e9",
      "name": "Deduplicate"
    },
    {
      "parameters": {
        "jsCode": "const xml = $input.first().json.data;\n\nif (!xml || typeof xml !== 'string') {\n  return [];\n}\n\nconst papers = [];\nconst entryMatches = xml.match(/<entry>[\\s\\S]*?<\\/entry>/g) || [];\n\nfor (const entry of entryMatches) {\n  const getTag = (tag) => {\n    const match = entry.match(new RegExp(`<${tag}[^>]*>([\\\\s\\\\S]*?)<\\\\/${tag}>`));\n    return match ? match[1].trim().replace(/\\s+/g, ' ') : '';\n  };\n\n  const title = getTag('title');\n  const summary = getTag('summary');\n  const published = getTag('published');\n  const id = getTag('id');\n\n  const authorMatches = entry.match(/<author>[\\s\\S]*?<name>([\\s\\S]*?)<\\/name>[\\s\\S]*?<\\/author>/g) || [];\n  const authors = authorMatches.map(a => {\n    const nameMatch = a.match(/<name>([\\s\\S]*?)<\\/name>/);\n    return nameMatch ? nameMatch[1].trim() : '';\n  }).join(', ');\n\n  if (title) {\n    papers.push({\n      json: {\n        paper_id: id || `${title}-${Date.now()}`,\n        title: title,\n        authors: authors,\n        abstract: summary,\n        source: 'arxiv',\n        url: id || '',\n        published_date: published || '',\n        matched_topic: $('Loop Over Items').first().json.topic || ''\n      }\n    });\n  }\n}\n\nreturn papers;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
