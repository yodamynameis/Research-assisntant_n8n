              "id": "3d62bd75-3b87-4093-808c-349aef9430c7",
              "name": "email_body",
              "value": "=Hi {{ $('code').item.json.user_name }},<br><br>\n\n{{ $json.text }}<br><br>\n\nHere's what we found this week:<br><br>\n\n{{ $('code').item.json.papers.map((p, i) => `<b>${i+1}. ${p.title}</b><br>Authors: ${p.authors}<br>${p.summary}<br>Read more: <a href=\"${p.url}\">${p.url}</a>`).join('<br><br>') }}\n\n<br><br>Happy researching!",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
