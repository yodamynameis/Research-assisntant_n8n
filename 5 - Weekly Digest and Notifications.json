      "id": "1be7e72d-4d8e-4c7f-9867-3eef3ae7bff2",
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "jsCode": "const currentUser = $('Loop Over Items').first().json;\nconst userTopic = (currentUser.topic || '').toLowerCase();\nconst userKeywordList = userTopic.split(',').map(k => k.trim()).filter(Boolean);\n\nconst allPapers = $input.all().map(item => item.json);\n\n// Only papers collected in the last 7 days\nconst oneWeekAgo = new Date();\noneWeekAgo.setDate(oneWeekAgo.getDate() - 7);\n\nconst matchingPapers = allPapers.filter(paper => {\n  const collectedDate = new Date(paper.date_collected);\n  const isRecent = collectedDate >= oneWeekAgo;\n\n  const paperText = `${(paper.keywords || '').toLowerCase()} ${(paper.matched_topic || '').toLowerCase()} ${(paper.title || '').toLowerCase()}`;\n  const matchesTopic = userKeywordList.some(kw => paperText.includes(kw));\n\n  return isRecent && matchesTopic;\n});\n\nif (matchingPapers.length === 0) {\n  return []; // no new papers this week for this user — skip sending\n}\n\nreturn [{\n  json: {\n    user_name: currentUser.name,\n    user_email: currentUser.email,\n    topic: currentUser.topic,\n    paper_count: matchingPapers.length,\n    papers: matchingPapers\n  }\n}];"
      },
