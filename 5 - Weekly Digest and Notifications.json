    {
      "parameters": {
        "promptType": "define",
        "text": "=You are writing a friendly weekly research digest email for {{ $json.user_name }}, who is interested in: {{ $json.topic }}\n\nHere are the papers found this week:\n{{ $json.papers.map((p, i) => (i+1) + \". \" + p.title + \" - \" + p.summary).join(\"\\n\\n\") }}\n\nWrite a warm, concise intro paragraph (2-3 sentences) for this email, mentioning how many papers were found and briefly setting expectations for what's below. Do not repeat the full paper list — that will be added separately below your intro.\nDo NOT include any closing line, sign-off, \"Best regards\", or \"[Your Name]\" placeholder at the end",
        "batching": {}
